#!/usr/bin/env python3
"""Semantic code search over the Qdrant index of the current project (kept fresh by herdr-index).

Usage: herdr-search [options] <query...>
  --files N     number of files to return (default 6)
  --path P      only files under path prefix P (repeatable)
  --list        print ranked paths with line ranges only, no snippets
  --all         include tests, specs and log archives at full weight

Ranking is semantic (Ollama nomic-embed-text + Qdrant), with a lexical boost for
files that contain identifier-like query terms (camelCase, snake_case, dotted,
`backticked`), checked with `git grep` against the working tree. Snippets are
re-located against the file on disk, so line numbers stay right after edits the
index hasn't caught up with; chunks that no longer exist are marked stale.
"""
import os, re, sys, json, hashlib, subprocess, requests

QDRANT = os.environ.get("HERDR_QDRANT", "http://localhost:6333")
OLLAMA = os.environ.get("HERDR_OLLAMA", "http://localhost:11434") + "/api/embeddings"
INDEXER = os.path.expanduser("~/.local/bin/herdr-index")
HEALTH = os.path.join(os.environ.get("HERDR_INDEX_CACHE") or os.path.expanduser("~/.cache/herdr-index"), "health.json")
TIMEOUT = 20
REFRESH_BUDGET = 25  # seconds of foreground indexing before handing off to the background
CANDIDATES = 64      # raw semantic hits fetched before grouping
CONTEXT = 3          # lines of context around each hit
MAX_SNIPPET = 40     # lines printed per merged range
MAX_RANGES = 3       # ranges printed per file
LEXICAL_BOOST = 0.04 # per matched identifier, capped at 2
GREP_ONLY_FILES = 2  # files found only by identifier match that may be added

def fail(msg):
    sys.exit(f"herdr-search: {msg}")

def unavailable(cause):
    """A backend is down: re-probe (which raises the Herdr warning) and say what is wrong."""
    detail = ""
    try:
        subprocess.run([INDEXER, "--doctor", "--quiet"], capture_output=True, timeout=60)
        detail = "; ".join(json.load(open(HEALTH)).get("problems", []))
    except Exception:
        pass
    fail(f"semantic search is unavailable: {detail or cause}. Tell the user the search backend needs "
         f"attention before falling back to grep.")

# Flags may arrive as separate argv entries or embedded at the start of a single
# query string (the pi tool passes one argument).
argv = " ".join(sys.argv[1:]).split()
max_files, include_all, list_only, prefixes = 6, False, False, []
while argv and argv[0].startswith("--"):
    flag = argv.pop(0)
    if flag == "--files" and argv:
        max_files = max(1, int(argv.pop(0)))
    elif flag == "--path" and argv:
        prefixes.append(argv.pop(0).strip("/").removeprefix("./"))
    elif flag == "--list":
        list_only = True
    elif flag == "--all":
        include_all = True
    else:
        fail(f"unknown option {flag}")
QUERY = " ".join(argv)
if not QUERY: sys.exit(0)

def git(cwd, *a):
    try:
        return subprocess.run(["git", *a], cwd=cwd, capture_output=True, text=True, check=True).stdout.strip()
    except Exception:
        return ""

def collection_for(path):
    # Collection naming: "ws-" + first 16 hex chars of sha256(path).
    return "ws-" + hashlib.sha256(path.encode("utf-8")).hexdigest()[:16]

# The index is keyed by the workspace folder: the git root of the current
# directory. Inside a linked worktree with no index of its own, use the main checkout's
# index but read files from the worktree.
work_root = git(os.getcwd(), "rev-parse", "--show-toplevel") or os.getcwd()
common = git(work_root, "rev-parse", "--path-format=absolute", "--git-common-dir")
main_root = os.path.dirname(common) if os.path.basename(common) == ".git" else ""
try:
    collections = [c["name"] for c in requests.get(f"{QDRANT}/collections", timeout=TIMEOUT).json()["result"]["collections"]]
except Exception as e:
    unavailable(f"Qdrant unreachable at {QDRANT} ({e})")
index_root = next((r for r in (work_root, main_root) if r and collection_for(r) in collections), main_root or work_root)
target = os.environ.get("HERDR_COLLECTION") or collection_for(index_root)

# Keep the index fresh without VS Code: herdr-index re-embeds only changed files. Work beyond
# the time budget continues in a detached background run.
notes = []
if os.path.exists(INDEXER) and not os.environ.get("HERDR_NO_REFRESH") and git(index_root, "rev-parse", "--is-inside-work-tree") == "true":
    try:
        r = subprocess.run([INDEXER, "--quiet", "--budget", str(REFRESH_BUDGET), "--root", index_root, *(["--collection", target] if os.environ.get("HERDR_COLLECTION") else [])],
                           capture_output=True, text=True, timeout=REFRESH_BUDGET + 90)
        if r.returncode == 3:
            subprocess.Popen([INDEXER, "--quiet", "--root", index_root], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            notes.append("[index refresh continuing in background; recent changes may be missing from results]")
        elif r.returncode == 4:
            notes.append("[another indexer run is in progress; results may be missing recent changes]")
        elif r.returncode != 0:
            notes.append(f"[index refresh failed: {(r.stderr or '').strip()[:200]}]")
    except Exception as e:
        notes.append(f"[index refresh failed: {e}]")
    try:
        collections = [c["name"] for c in requests.get(f"{QDRANT}/collections", timeout=TIMEOUT).json()["result"]["collections"]]
    except Exception:
        pass
if target not in collections:
    fail(f"this project is not indexed (no {target} for {index_root}). Run `herdr-index --root {index_root}`.")
for n in notes:
    print(n)

try:
    vector = requests.post(OLLAMA, json={"model": "nomic-embed-text", "prompt": QUERY}, timeout=TIMEOUT).json()["embedding"]
except Exception as e:
    unavailable(f"embedding failed via Ollama ({e}); is `ollama serve` running with nomic-embed-text?")

body = {"query": vector, "limit": CANDIDATES, "with_payload": True}
if prefixes:
    # Qdrant can't prefix-match strings, so filter on the leading path segments.
    should = []
    for pre in prefixes:
        parts = [s for s in pre.split("/") if s]
        should.append({"must": [{"key": f"pathSegments.{i}", "match": {"value": s}} for i, s in enumerate(parts)]})
    body["filter"] = {"should": should}
try:
    points = requests.post(f"{QDRANT}/collections/{target}/points/query", json=body,
                           timeout=TIMEOUT).json().get("result", {}).get("points", [])
except Exception as e:
    unavailable(f"Qdrant query failed ({e})")

def weight(path):
    # Prefer implementation over tests and drop archived logs unless --all.
    if include_all: return 0.0
    if "/log-archive/" in path or path.startswith("log-archive/"): return None
    if any(t in path for t in (".test.", ".spec.", "/__tests__/")): return -0.03
    return 0.0

def in_scope(path):
    return not prefixes or any(path == p or path.startswith(p + "/") for p in prefixes)

files = {}
for p in points:
    pl = p.get("payload", {})
    path = pl.get("filePath")
    if not path or not in_scope(path): continue
    w = weight(path)
    if w is None: continue
    start = int(pl.get("startLine") or 1)
    end = int(pl.get("endLine") or start)
    f = files.setdefault(path, {"score": float("-inf"), "hits": [], "lexical": []})
    f["score"] = max(f["score"], p.get("score", 0) + w)
    f["hits"].append((start, end, pl.get("codeChunk") or ""))

# Lexical boost: identifier-like terms are matched exactly in the working tree.
terms = set(re.findall(r"`([^`]+)`", QUERY))
for tok in re.findall(r"[A-Za-z_][\w.]*", QUERY):
    if len(tok) >= 4 and (re.search(r"[a-z][A-Z]", tok) or "_" in tok or "." in tok.strip(".")):
        terms.add(tok.strip("."))
grep_hits = {}
for term in sorted(terms):
    out = git(work_root, "grep", "-n", "-F", "-I", "--", term, *(prefixes or ["."]))
    for line in out.splitlines():
        m = re.match(r"(.+?):(\d+):", line)
        if not m: continue
        path, ln = m.group(1), int(m.group(2))
        if weight(path) is None: continue
        grep_hits.setdefault(path, {}).setdefault(term, ln)
for path, found in grep_hits.items():
    boost = LEXICAL_BOOST * min(2, len(found))
    if path in files:
        files[path]["score"] += boost
        files[path]["lexical"] = sorted(found)
grep_only = sorted((p for p in grep_hits if p not in files),
                   key=lambda p: (-len(grep_hits[p]), weight(p) or 0, p))[:GREP_ONLY_FILES]
floor = min((f["score"] for f in files.values()), default=0.5)
for path in grep_only:
    found = grep_hits[path]
    files[path] = {"score": floor - 0.001, "lexical": sorted(found),
                   "hits": [(ln, ln, "") for ln in found.values()], "grep_only": True}

def read_lines(path):
    try:
        with open(os.path.join(work_root, path), "r", encoding="utf-8") as fh:
            return fh.readlines()
    except Exception:
        return None

def squash(text):
    return re.sub(r"\s+", " ", text).strip()

def relocate(lines, start, end, chunk):
    """Find the chunk's current position on disk; returns (start, end, stale).

    Chunks can begin and end mid-line, and the file may have been edited since indexing: compare
    with whitespace collapsed and allow the chunk to sit inside the lines."""
    want = squash(chunk)
    if not want: return start, end, False
    if want in squash("".join(lines[start - 1:end])): return start, end, False
    n = max(1, end - start + 1)
    head = squash(chunk.splitlines()[0])
    cands = [i for i, l in enumerate(lines) if head and head in squash(l)]
    for i in sorted(cands, key=lambda i: abs(i + 1 - start)):
        if want in squash("".join(lines[i:i + n + 1])):
            return i + 1, i + n, False
    return start, end, True

def merge(ranges, total):
    out = []
    for s, e, stale in sorted((max(1, s - CONTEXT), min(total, e + CONTEXT), st) for s, e, st in ranges):
        if out and s <= out[-1][1] + 1:
            out[-1] = (out[-1][0], max(out[-1][1], e), out[-1][2] and stale)
        else:
            out.append((s, e, stale))
    return out

ranked = sorted(files.items(), key=lambda kv: kv[1]["score"], reverse=True)[:max_files]
if not ranked:
    print("No results found.")
for path, f in ranked:
    lines = read_lines(path)
    tags = [f"score {f['score']:.3f}"]
    if f.get("lexical"): tags.append("matches " + ", ".join(f["lexical"]))
    if f.get("grep_only"): tags.append("identifier match only")
    if lines is None:
        print(f"--- File: {path} ({'; '.join(tags)}) ---\n[not readable in working tree]\n")
        continue
    ranges = merge([relocate(lines, s, e, c) for s, e, c in f["hits"]], len(lines))[:MAX_RANGES]
    if list_only:
        spans = ", ".join(f"{s}-{e}{' stale' if st else ''}" for s, e, st in ranges)
        print(f"{path}: {spans} ({'; '.join(tags)})")
        continue
    for s, e, stale in ranges:
        e = min(e, s + MAX_SNIPPET - 1)
        note = "; index stale here, showing indexed line numbers" if stale else ""
        print(f"--- File: {path} (Lines {s}-{e}, {'; '.join(tags)}{note}) ---")
        print("".join(lines[s - 1:e]).rstrip())
        print()
